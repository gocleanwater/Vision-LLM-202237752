# Project01처럼 제출에 필요한 파일만 포함한다.
/*
!/.gitignore
!/README.md
!/main.py
!/vision.py
!/speech.py
!/gemma.py

# 발표 PDF와 README 표지 미리보기를 포함한다.
!/Project02_presentation.pdf
!/Project02_cover.png
!/assets/
/assets/*
!/assets/slides/
/assets/slides/*
!/assets/slides/page-*.png
/.presentation-build/

# 테스트·실행 자료·기타 모델은 제출하지 않는다.
tests/
runtime/
recent_meals.json
recent_meals.json.tmp
*.engine
*.pt
*.onnx
*.gguf
*.wav
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv*/
.env
.DS_Store

# 최종 실행에 사용하는 식재료 FP32 엔진은 제출한다.
!/ingredients_fp32.engine

# README에서 재생할 최종 시연 영상만 포함한다.
!/yolo_demo.mp4
!/full_demo.mp4

# 설계·작업 문서는 로컬에만 보관한다.
/documents/
/document/
